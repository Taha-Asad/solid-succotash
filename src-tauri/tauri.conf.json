{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Corbel ERP",
  "version": "1.2.0",
  "identifier": "com.thefoolishcrow.corbel",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run fetch-tesseract"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Corbel ERP",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app"],
    "createUpdaterArtifacts": true,
    "resources": {
      "bin/tesseract": "tesseract"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      },
      "wix": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Taha-Asad/solid-succotash/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4MUVBQkNEQUZEMTlDN0QKUldSOW5OR3Z6YXNlT0pyMy9TT3NJWkZ1N3crd2lGZnA3TFBMdUlwMCtaYnFPTTQrdzlqeGNkYkcK"
    }
  }
}
